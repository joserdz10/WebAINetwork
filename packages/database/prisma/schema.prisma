generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StateBrainStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MediaIdentityStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TopicStatus {
  ACTIVE
  WATCHING
  PAUSED
  ARCHIVED
}

enum WatchType {
  TOPIC
  PROFILE
  ORGANIZATION
  KEYWORD
  EVENT
}

enum StoryStatus {
  DISCOVERED
  ANALYZING
  READY
  GENERATING
  CONTENT_READY
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum ContentPieceType {
  FACEBOOK_POST
  FACEBOOK_STORY
  INSTAGRAM_POST
  INSTAGRAM_STORY
  INSTAGRAM_REEL
  X_POST
  TIKTOK
  ARTICLE
  EDITORIAL_GRAPHIC
}

enum ContentPieceStatus {
  DRAFT
  GENERATED
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  FAILED
}

enum PublicationStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  TELEGRAM
  WEBSITE
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum SourceType {
  WEBSITE
  RSS
  SOCIAL
  API
  MANUAL
  GOVERNMENT
  MEDIA
}

model Country {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  isActive    Boolean      @default(true)
  stateBrains StateBrain[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model StateBrain {
  id              String              @id @default(cuid())
  countryId       String
  slug            String              @unique
  name            String
  stateCode       String?
  status          StateBrainStatus    @default(DRAFT)
  description     String?
  configuration   Json?
  country         Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  identities      MediaIdentity[]
  topics          Topic[]
  profiles        Profile[]
  watches         Watch[]
  sources         Source[]
  stories         Story[]
  runs            DiscoveryRun[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([countryId, status])
}

model MediaIdentity {
  id              String               @id @default(cuid())
  stateBrainId    String
  slug            String               @unique
  name            String
  code            String?              @unique
  status          MediaIdentityStatus  @default(DRAFT)
  description     String?
  logoUrl         String?
  websiteUrl      String?
  stateBrain      StateBrain           @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  mediaDNA        MediaDNA?
  contentPieces   ContentPiece[]
  socialAccounts  SocialAccount[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([stateBrainId, status])
}

model MediaDNA {
  id                 String        @id @default(cuid())
  mediaIdentityId    String        @unique
  tone               String?
  editorialStyle     String?
  geographicFocus    String?
  headlineStyle      String?
  politicalTone      String?
  audience           String?
  language           String        @default("es-MX")
  avoidRules         Json?
  preferredFormats   Json?
  promptInstructions String?
  brandRules         Json?
  mediaIdentity      MediaIdentity @relation(fields: [mediaIdentityId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Topic {
  id             String        @id @default(cuid())
  stateBrainId   String
  slug           String
  name           String
  description    String?
  status         TopicStatus   @default(ACTIVE)
  priority       Priority      @default(NORMAL)
  keywords       Json?
  stateBrain     StateBrain    @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  storyLinks     StoryTopic[]
  profileLinks   ProfileTopic[]
  watchLinks     WatchTopic[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([stateBrainId, slug])
  @@index([stateBrainId, status, priority])
}

model Profile {
  id             String         @id @default(cuid())
  stateBrainId   String
  slug           String
  name           String
  type           String?
  description    String?
  aliases        Json?
  metadata       Json?
  stateBrain     StateBrain     @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  storyLinks     StoryProfile[]
  topicLinks     ProfileTopic[]
  watchLinks     WatchProfile[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([stateBrainId, slug])
  @@index([stateBrainId, name])
}

model Watch {
  id             String         @id @default(cuid())
  stateBrainId   String
  name           String
  type           WatchType
  query          String?
  isActive       Boolean        @default(true)
  priority       Priority       @default(NORMAL)
  configuration  Json?
  stateBrain     StateBrain     @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  topicLinks     WatchTopic[]
  profileLinks   WatchProfile[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([stateBrainId, isActive, priority])
}

model Source {
  id             String       @id @default(cuid())
  stateBrainId   String
  name           String
  type           SourceType
  url            String?
  domain         String?
  isActive       Boolean      @default(true)
  trustScore     Float?
  configuration  Json?
  stateBrain     StateBrain   @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  storyLinks     StorySource[]
  runItems       DiscoveryRunItem[]
  candidates     DiscoveryCandidate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([stateBrainId, isActive])
}

model Story {
  id                  String           @id @default(cuid())
  stateBrainId        String
  publicId            Int              @default(autoincrement()) @unique
  title               String
  slug                String?
  status              StoryStatus      @default(DISCOVERED)
  priority            Priority         @default(NORMAL)
  confidence          ConfidenceLevel?
  summary             String?
  context             String?
  keyFacts            Json?
  actors              Json?
  timeline            Json?
  contradictions      Json?
  editorialRisks      Json?
  sourceAssessment    Json?
  generationContext   Json?
  detectedAt          DateTime         @default(now())
  readyAt             DateTime?
  publishedAt         DateTime?
  stateBrain          StateBrain       @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  sources             StorySource[]
  topics              StoryTopic[]
  profiles            StoryProfile[]
  contentPieces       ContentPiece[]
  runItems            DiscoveryRunItem[]
  discoveryCandidates DiscoveryCandidate[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([stateBrainId, status, priority])
  @@index([detectedAt])
}

model StorySource {
  storyId        String
  sourceId       String
  sourceUrl      String?
  sourceTitle    String?
  publishedAt    DateTime?
  excerpt        String?
  isPrimary      Boolean      @default(false)
  verification   Json?
  story          Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  source         Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([storyId, sourceId])
  @@index([sourceId])
}

model StoryTopic {
  storyId String
  topicId String
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([storyId, topicId])
}

model StoryProfile {
  storyId   String
  profileId String
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([storyId, profileId])
}

model ProfileTopic {
  profileId String
  topicId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([profileId, topicId])
}

model WatchTopic {
  watchId String
  topicId String
  watch   Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([watchId, topicId])
}

model WatchProfile {
  watchId   String
  profileId String
  watch     Watch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([watchId, profileId])
}

model ContentPiece {
  id               String             @id @default(cuid())
  storyId          String
  mediaIdentityId  String
  type             ContentPieceType
  status           ContentPieceStatus @default(DRAFT)
  version          Int                @default(1)
  headline         String?
  copy             String?
  body             String?
  imageUrl         String?
  videoUrl         String?
  metadata         Json?
  generationPrompt String?
  approvedAt       DateTime?
  story            Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  mediaIdentity    MediaIdentity      @relation(fields: [mediaIdentityId], references: [id], onDelete: Cascade)
  publications     Publication[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([storyId, status])
  @@index([mediaIdentityId, type, status])
}

model SocialAccount {
  id               String          @id @default(cuid())
  mediaIdentityId  String
  platform         SocialPlatform
  name             String
  externalAccountId String?
  username         String?
  isActive         Boolean         @default(true)
  connectionStatus String          @default("PENDING")
  credentialsRef   String?
  configuration    Json?
  mediaIdentity    MediaIdentity   @relation(fields: [mediaIdentityId], references: [id], onDelete: Cascade)
  publications     Publication[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([mediaIdentityId, platform, name])
  @@index([mediaIdentityId, platform, isActive])
}

model Publication {
  id                String             @id @default(cuid())
  contentPieceId    String
  socialAccountId   String
  status            PublicationStatus  @default(PENDING)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  externalPostId    String?
  externalUrl       String?
  errorCode         String?
  errorMessage      String?
  attemptCount      Int                @default(0)
  metadata          Json?
  contentPiece      ContentPiece       @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, scheduledAt])
  @@index([socialAccountId, status])
}

model DiscoveryRun {
  id                String        @id @default(cuid())
  stateBrainId      String
  status            RunStatus     @default(QUEUED)
  startedAt         DateTime?
  finishedAt        DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  itemsScanned      Int           @default(0)
  candidatesFound   Int           @default(0)
  storiesCreated    Int           @default(0)
  itemsDiscarded    Int           @default(0)
  summary           Json?
  errorMessage      String?
  stateBrain        StateBrain    @relation(fields: [stateBrainId], references: [id], onDelete: Cascade)
  items             DiscoveryRunItem[]
  candidates        DiscoveryCandidate[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stateBrainId, status, createdAt])
}

model DiscoveryRunItem {
  id             String       @id @default(cuid())
  discoveryRunId String
  sourceId       String?
  storyId        String?
  externalId     String?
  url            String?
  title          String?
  publishedAt    DateTime?
  rawPayload     Json?
  relevanceScore Float?
  decision       String?
  discardReason  String?
  discoveryRun   DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  source         Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  story          Story?       @relation(fields: [storyId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([discoveryRunId, decision])
}


model DiscoveryCandidate {
  id             String       @id @default(cuid())
  discoveryRunId String
  sourceId       String?
  storyId        String?
  url            String
  canonicalUrl   String?
  title          String
  excerpt        String?
  publishedAt    DateTime?
  relevanceScore Float        @default(0)
  duplicateKey   String?
  status         String       @default("PENDING")
  decisionReason String?
  metadata       Json?
  discoveryRun   DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  source         Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  story          Story?       @relation(fields: [storyId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([discoveryRunId, status, relevanceScore])
  @@index([sourceId, publishedAt])
  @@index([duplicateKey])
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ActivityEvent {
  id          String   @id @default(cuid())
  type        String
  scope       String?
  entityType  String?
  entityId    String?
  title       String
  detail      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type, scope])
}

model SystemError {
  id          String   @id @default(cuid())
  code        String
  module      String
  message     String
  detail      String?
  entityType  String?
  entityId    String?
  resolved    Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([resolved, createdAt])
  @@index([module, code])
}

model JobRecord {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(QUEUED)
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}
